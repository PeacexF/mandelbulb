{
  "name": "mandelbulb",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "wasm:build": "GOOS=js GOARCH=wasm go build -C .. -o web/public/mandelbulb.wasm ./wasm",
    "wasm:exec": "cp \"$(go env GOROOT)/lib/wasm/wasm_exec.js\" public/wasm_exec.js",
    "wasm": "npm run wasm:build && npm run wasm:exec",
    "predev": "npm run wasm",
    "prebuild": "npm run wasm",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "check": "tsc -b --noEmit"
  },
  "devDependencies": {
    "@webgpu/types": "^0.1.72",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
